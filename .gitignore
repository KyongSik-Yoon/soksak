# Android build artifacts are ignored by android/.gitignore; this is a backstop
**/build/
**/.gradle/
**/local.properties
**/.cxx/

# Swift Package Manager
/.build/
**/.build/
.swiftpm/

# Xcode
xcuserdata/
*.xcodeproj/*.xcuserdatad/
DerivedData/
*.xcuserstate

# macOS packaging artifacts (Release build + .dmg output)
macos/App/build-release/
macos/App/build-eval/
macos/App/build-bench/
macos/dist/
*.dmg

# Vendored sherpa-onnx + onnxruntime xcframeworks for macOS on-device Parakeet STT — large
# prebuilt binaries, regenerable via macos/SherpaOnnxFramework/fetch-binaries.sh.
macos/SherpaOnnxFramework/binaries/

# Vendored sherpa-onnx AAR, fetched by CI
android/app/libs/*.aar
