<?xml version="1.0" encoding="utf-8"?>
<!-- Dictation widget: the mark on a fixed-size plum disc, centred in whatever cell the host gives
     (One UI lock screen hands it 100x100dp, home 63x114dp); filling the cell made it huge.
     The whole cell stays tappable. RemoteViews-safe views only. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_bg">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:contentDescription="@string/widget_label"
            android:src="@drawable/ic_mark" />
    </FrameLayout>
</FrameLayout>
