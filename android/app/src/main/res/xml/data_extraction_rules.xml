<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone through Android backup (API 31+). App data holds the PC pairing code,
  dictated text and raw recordings; on targetSdk 31+ allowBackup="false" alone still allows
  device-to-device transfer, so both are excluded here. Settings → General has a manual backup
  that leaves secrets out.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
