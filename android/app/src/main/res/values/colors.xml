<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Soksak "dusk" palette; the Compose theme (ui/Theme.kt) is authoritative, these are the
         few values XML resources need. -->
    <!-- Window background behind the first frame (Theme.kt light background). -->
    <color name="app_bg">#F5F3F8</color>
    <!-- Light stroke of the mark (ic_mark), recoloured by tint where used. -->
    <color name="mark_light">#F7F5FB</color>
    <!-- Splash background: same plum as the launcher icon -->
    <color name="splash_bg">#3B2F4A</color>
</resources>
