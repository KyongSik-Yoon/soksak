+  // The tensor as passed to graphExecute. Stored tensors keep their client
+  // buffer, which memHandle would overwrite: it is how data is read and written.
+  Qnn_Tensor_t ForExecute(const Qnn_Tensor_t *t) const {
+    Qnn_Tensor_t ans = *t;
+    auto it = mem_handles_.find(t);
+    if (it != mem_handles_.end()) {
+      ans.v1.memType = QNN_TENSORMEMTYPE_MEMHANDLE;
+      ans.v1.memHandle = it->second;
+    }
+    return ans;
+  }
+
+  // Puts every tensor in one rpcmem block registered with the HTP, so that
+  // graphExecute hands over offsets instead of copying the buffers on each call.
+  // Returns false, with nothing left allocated, if any step is unavailable.
+  bool AllocateSharedBuffer() {
+    auto qi = backend_->QnnInterface();
+    if (!qi.memRegister || !qi.memDeRegister) {
+      return false;
+    }
+
+    rpc_lib_.reset(dlopen("libcdsprpc.so", RTLD_NOW | RTLD_LOCAL));
+    if (!rpc_lib_) {
+      SHERPA_ONNX_LOGE("QNN shared memory: no libcdsprpc.so, using copies");
+      return false;
+    }
+
+    using AllocFn = void *(*)(int heap_id, uint32_t flags, int size);
+    using ToFdFn = int (*)(void *p);
+    auto alloc = reinterpret_cast<AllocFn>(dlsym(rpc_lib_.get(), "rpcmem_alloc"));
+    auto to_fd = reinterpret_cast<ToFdFn>(dlsym(rpc_lib_.get(), "rpcmem_to_fd"));
+    rpc_free_ = reinterpret_cast<FreeFn>(dlsym(rpc_lib_.get(), "rpcmem_free"));
+    if (!alloc || !to_fd || !rpc_free_) {
+      SHERPA_ONNX_LOGE("QNN shared memory: no rpcmem symbols, using copies");
+      return false;
+    }
+
+    constexpr int kHeapIdSystem = 25;
+    constexpr uint32_t kDefaultFlags = 1;
+    constexpr uint64_t kAlignment = 4096;
+
+    std::vector<std::pair<Qnn_Tensor_t *, uint64_t>> layout;
+    uint64_t total = 0;
+    auto place = [&](const std::vector<TensorPtr> &tensors) {
+      for (const auto &t : tensors) {
+        layout.emplace_back(t.get(), total);
+        total += (t->v1.clientBuf.dataSize + kAlignment - 1) / kAlignment *
+                 kAlignment;
+      }
+    };
+    place(input_tensors_);
+    place(output_tensors_);
+
+    if (total > static_cast<uint64_t>(INT32_MAX)) {
+      return false;
+    }
+
+    rpc_block_ = alloc(kHeapIdSystem, kDefaultFlags, static_cast<int>(total));
+    if (!rpc_block_) {
+      SHERPA_ONNX_LOGE("QNN shared memory: cannot allocate %.1f MB, using copies",
+                       static_cast<float>(total) / 1024 / 1024);
+      return false;
+    }
+
+    int fd = to_fd(rpc_block_);
+    if (fd < 0) {
+      SHERPA_ONNX_LOGE("QNN shared memory: no file descriptor, using copies");
+      FreeSharedBuffer();
+      return false;
+    }
+
+    for (const auto &entry : layout) {
+      Qnn_Tensor_t *t = entry.first;
+
+      QnnMemHtp_Descriptor_t htp{};
+      htp.type = QNN_HTP_MEM_SHARED_BUFFER;
+      htp.size = total;
+      htp.sharedBufferConfig.fd = fd;
+      htp.sharedBufferConfig.offset = entry.second;
+
+      Qnn_MemDescriptor_t descriptor = QNN_MEM_DESCRIPTOR_INIT;
+      descriptor.memShape.numDim = t->v1.rank;
+      descriptor.memShape.dimSize = t->v1.dimensions;
+      descriptor.memShape.shapeConfig = nullptr;
+      descriptor.dataType = t->v1.dataType;
+      descriptor.memType = QNN_MEM_TYPE_CUSTOM;
+      descriptor.customInfo = &htp;
+
+      Qnn_MemHandle_t handle = nullptr;
+      auto ret = qi.memRegister(backend_->ContextHandle(), &descriptor, 1, &handle);
+      if (ret != QNN_SUCCESS) {
+        SHERPA_ONNX_LOGE("QNN shared memory: memRegister failed (%d), using copies",
+                         static_cast<int32_t>(ret));
+        FreeSharedBuffer();
+        return false;
+      }
+
+      mem_handles_[t] = handle;
+      t->v1.clientBuf.data = static_cast<uint8_t *>(rpc_block_) + entry.second;
+    }
+
+    SHERPA_ONNX_LOGE("QNN shared memory: %d tensors, %.1f MB",
+                     static_cast<int32_t>(layout.size()),
+                     static_cast<float>(total) / 1024 / 1024);
+    return true;
+  }
+
+  void DeregisterSharedBuffer() {
+    if (mem_handles_.empty()) {
+      return;
+    }
+
+    std::vector<Qnn_MemHandle_t> handles;
+    handles.reserve(mem_handles_.size());
+    for (const auto &p : mem_handles_) {
+      handles.push_back(p.second);
+    }
+    mem_handles_.clear();
+
+    auto ret = backend_->QnnInterface().memDeRegister(handles.data(),
+                                                      handles.size());
+    if (ret != QNN_SUCCESS) {
+      SHERPA_ONNX_LOGE("QNN shared memory: memDeRegister failed (%d)",
+                       static_cast<int32_t>(ret));
+    }
+  }
+
+  void FreeSharedBuffer() {
+    DeregisterSharedBuffer();
+    if (rpc_block_) {
+      rpc_free_(rpc_block_);
+      rpc_block_ = nullptr;
+    }
+  }
